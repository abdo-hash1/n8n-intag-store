# ===========================================
# n8n SaaS Platform - Backend Environment
# ===========================================

# ------------------------------------------
# Database Configuration
# ------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/n8n_saas?schema=public"

# ------------------------------------------
# JWT Configuration
# ------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-this-too"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=3001
NODE_ENV=development
API_PREFIX=/api

# ------------------------------------------
# CORS Configuration
# ------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------
# Payment Gateway - Paymob
# ------------------------------------------
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC_SECRET=""
PAYMOB_BASE_URL="https://accept.paymob.com/api"

# ------------------------------------------
# Email Service - SendGrid
# ------------------------------------------
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="n8n SaaS Platform"

# ------------------------------------------
# Pricing Configuration (in EGP)
# ------------------------------------------
MONTHLY_PRICE=400
ANNUAL_PRICE=3800
CURRENCY=EGP

# ------------------------------------------
# Business Rules
# ------------------------------------------
REFUND_PERIOD_DAYS=7
GRACE_PERIOD_DAYS=7
DATA_RETENTION_DAYS=30

# ------------------------------------------
# Security
# ------------------------------------------
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------
# Logging
# ------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=combined

# ------------------------------------------
# Docker/n8n Configuration
# ------------------------------------------
N8N_BASE_PORT=5000
N8N_DOMAIN=n8n.yourdomain.com
N8N_ENCRYPTION_KEY=""

# ------------------------------------------
# Admin Configuration
# ------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=change-this-immediately
